# Muss dem Repository-Namen entsprechen (GitHub Pages Projekt-Site).
# Leer lassen fuer Entwicklung unter http://localhost:3000/
NEXT_PUBLIC_BASE_PATH=/1789-website-brutal

# Flux-API von Black Forest Labs, nur fuer `npm run covers`.
# Den Schluessel in .env.local eintragen (gitignoriert), nie hier und nie im Repo.
# BFL_API_KEY=
# Optional ein anderes Modell, Standard ist flux-pro-1.1:
# BFL_MODEL=flux-pro-1.1
